# Copier ce fichier en « .env » (jamais envoyé sur GitHub) et remplir les deux valeurs.
# Elles se trouvent dans Supabase : Project Settings → API Keys.
# Ce sont des valeurs publiques. Ne jamais mettre ici la clé secrète (sb_secret_…),
# ni le mot de passe de la base.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
